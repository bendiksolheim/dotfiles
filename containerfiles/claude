# Pi Coding Agent inside an Apple container.
#
# Minimal Node image; pi installed globally, tools for the
# bash tool-call (find, grep, rg) available, /workspace as the
# mount target for the respective project.

FROM node:26-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      git \
      ripgrep \
      ca-certificates \
      iproute2 \
      fd-find \
 && rm -rf /var/lib/apt/lists/*

RUN npm install -g pnpm@latest-11

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME/bin:$PATH"

# Install Claude
RUN pnpm add -g --dangerously-allow-all-builds @anthropic-ai/claude-code

RUN useradd --create-home --shell /bin/bash claude

USER claude
WORKDIR /workspace

ENTRYPOINT ["claude"]
